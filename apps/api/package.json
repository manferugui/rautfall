{
  "name": "@rautfall/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/cli-migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@fastify/websocket": "^11.0.2",
    "@rautfall/battle-engine": "workspace:*",
    "@rautfall/contracts": "workspace:*",
    "@rautfall/game-config": "workspace:*",
    "@rautfall/game-engine": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.18.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.5.14",
    "drizzle-kit": "^0.30.4",
    "testcontainers": "^10.18.0",
    "tsx": "^4.19.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "ws": "^8.18.1"
  }
}
